# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real API keys to git.
#
# In v0/Vercel: Set these via Settings > Vars in the top-right menu.
# =============================================================================

# WakaTime API Integration
# Get your API key from: https://wakatime.com/settings/api-key
WAKATIME_API_KEY=

# Umami Analytics
# Get these from your Umami dashboard
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=

# Web Push Notifications (VAPID Keys)
# Generate at: https://vapidkeys.com/ or via web-push CLI
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your@email.com

# OpenAI (for SmartTalk AI chatbot)
# If using Replit AI Integrations, these are auto-provided
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=

# Database (if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
