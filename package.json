{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"import('fs').then(fs => { ['package-lock.json', 'yarn.lock'].forEach(f => fs.existsSync(f) && fs.existsSync(f) && fs.unlinkSync(f)); })\"",
    "dev": "pnpm --filter @workspace/portfolio run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build && node -e \"import('fs').then(fs => { if (fs.existsSync('artifacts/api-server/dist/app.mjs')) { fs.mkdirSync('api', { recursive: true }); fs.copyFileSync('artifacts/api-server/dist/app.mjs', 'api/app.mjs'); } })\"",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@google/generative-ai": "^0.24.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "nodemailer": "^8.0.5",
    "openai": "^6.34.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "resend": "^6.12.3",
    "web-push": "^3.6.7"
  },
  "private": true,
  "devDependencies": {
    "@esbuild/win32-x64": "^0.27.3",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "@tailwindcss/oxide-win32-x64-msvc": "4.2.1",
    "lightningcss-win32-x64-msvc": "1.31.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
